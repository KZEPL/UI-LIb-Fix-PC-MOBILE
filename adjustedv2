-- ============================================================
--  MAKE SECTION (FIXED - properly sizes and prevents overflow)
-- ============================================================
local function makeSection(column, name)
    local hasHeader = name ~= nil and name ~= ""
    local headerH = hasHeader and (isMobile and 35 or 40) or (isMobile and 4 or 6)

    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, 0, 0, headerH + (isMobile and 20 or 25))
    box.BackgroundColor3 = THEME.Border
    box.BorderSizePixel = 0
    box.Parent = column
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, -2, 1, -2)
    bg.Position = UDim2.new(0, 1, 0, 1)
    bg.BackgroundColor3 = THEME.ChildBg
    bg.BorderSizePixel = 0
    bg.Parent = box
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 3)

    if hasHeader then
        local hdr = Instance.new("TextLabel")
        hdr.Size = UDim2.new(1, -30, 0, (isMobile and 35 or 40))
        hdr.Position = UDim2.new(0, 15, 0, 0)
        hdr.BackgroundTransparency = 1
        hdr.Text = name
        hdr.TextColor3 = THEME.Text
        hdr.TextSize = isMobile and 12 or 13
        hdr.Font = Enum.Font.GothamBold
        hdr.TextXAlignment = Enum.TextXAlignment.Left
        hdr.TextWrapped = true  -- Enable wrapping for section headers too
        hdr.Parent = bg
    end

    local inner = Instance.new("Frame")
    inner.Name = "Inner"
    inner.Size = UDim2.new(1, -30, 0, 0)
    inner.Position = UDim2.new(0, 15, 0, headerH + (isMobile and 4 or 5))
    inner.BackgroundTransparency = 1
    inner.Parent = bg
    
    -- Use a UIListLayout with proper spacing
    local il = Instance.new("UIListLayout", inner)
    il.SortOrder = Enum.SortOrder.LayoutOrder
    il.Padding = UDim.new(0, isMobile and 6 or 10)  -- Slightly reduced padding for better fit

    -- Function to resize the box based on content
    local function resize()
        local h = il.AbsoluteContentSize.Y
        local padding = isMobile and 16 or 20
        local minHeight = headerH + (isMobile and 6 or 8) + padding
        
        -- If content height is 0 (empty section), use minimum height
        if h == 0 then
            inner.Size = UDim2.new(1, -30, 0, isMobile and 4 or 6)
            box.Size = UDim2.new(1, 0, 0, minHeight)
            return
        end
        
        inner.Size = UDim2.new(1, -30, 0, h)
        box.Size = UDim2.new(1, 0, 0, headerH + (isMobile and 4 or 5) + h + (isMobile and 14 or 18))
    end
    
    -- Connect resize to both content size changes and when children are added/removed
    il:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resize)
    
    -- Also resize when children are added/removed
    local function onChildChange()
        task.wait()  -- Allow the UIListLayout to update
        resize()
    end
    
    inner.ChildAdded:Connect(onChildChange)
    inner.ChildRemoved:Connect(onChildChange)
    
    -- Initial resize after a small delay
    task.wait(0.05)
    resize()

    return inner
end

