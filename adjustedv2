local function AddDropdown(parent, labelText, options, defaultIndex, callback)
    local selectedIndex = defaultIndex or 1
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, isMobile and 30 or 26)  -- Increased height
    row.BackgroundTransparency = 1
    row.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.4, 0, 1, 0)
    lbl.Position = UDim2.new(0, 0, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = THEME.Text
    lbl.TextSize = isMobile and 12 or 13
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextWrapped = true
    lbl.Parent = row

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.5, 0, 1, 0)  -- Slightly wider
    btn.Position = UDim2.new(0.45, 0, 0, 0)
    btn.BackgroundColor3 = THEME.FrameBg
    btn.BorderSizePixel = 0
    btn.Text = "  " .. options[selectedIndex]
    btn.TextColor3 = THEME.TextDisabled
    btn.TextSize = isMobile and 11 or 12
    btn.Font = Enum.Font.Gotham
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = row
    markNoDrag(btn)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)

    local open = false
    local listFrame = nil

    local function closeList()
        open = false
        if listFrame then listFrame:Destroy(); listFrame = nil end
    end

    btn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            listFrame = Instance.new("Frame")
            local relPos = btn.AbsolutePosition - MainWindow.AbsolutePosition
            listFrame.Position = UDim2.new(0, relPos.X, 0, relPos.Y + btn.AbsoluteSize.Y + 2)
            listFrame.Size = UDim2.new(0, btn.AbsoluteSize.X, 0, math.min(#options * (isMobile and 30 or 24) + 4, isMobile and 120 or 150))  -- Increased max height
            listFrame.BackgroundColor3 = THEME.PopupBg
            listFrame.BorderSizePixel = 0
            listFrame.ZIndex = 200
            listFrame.Active = true
            listFrame.Parent = MainWindow
            markNoDrag(listFrame)
            Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 3)

            local scroll = Instance.new("ScrollingFrame")
            scroll.Size = UDim2.new(1, 0, 1, 0)
            scroll.BackgroundTransparency = 1
            scroll.BorderSizePixel = 0
            scroll.ScrollBarThickness = 4
            scroll.ScrollBarImageColor3 = THEME.Border
            scroll.CanvasSize = UDim2.new(1, 0, 0, #options * (isMobile and 30 or 24))
            scroll.ZIndex = 201
            scroll.Parent = listFrame
            local sl = Instance.new("UIListLayout", scroll); sl.SortOrder = Enum.SortOrder.LayoutOrder

            for idx, opt in ipairs(options) do
                local isSelected = idx == selectedIndex
                local optBtn = Instance.new("TextButton")
                optBtn.Size = UDim2.new(1, 0, 0, isMobile and 30 or 24)
                optBtn.BackgroundColor3 = THEME.PopupBg
                optBtn.BorderSizePixel = 0
                optBtn.Text = ""
                optBtn.AutoButtonColor = false
                optBtn.ZIndex = 202
                optBtn.Parent = scroll

                local optLbl = Instance.new("TextLabel")
                optLbl.Size = UDim2.new(1, -30, 1, 0)
                optLbl.Position = UDim2.new(0, 8, 0, 0)
                optLbl.BackgroundTransparency = 1
                optLbl.Text = opt
                optLbl.TextColor3 = isSelected and THEME.Scheme or THEME.Text
                optLbl.TextSize = isMobile and 11 or 12
                optLbl.Font = Enum.Font.Gotham
                optLbl.TextXAlignment = Enum.TextXAlignment.Left
                optLbl.ZIndex = 203
                optLbl.Parent = optBtn

                optBtn.MouseButton1Click:Connect(function()
                    selectedIndex = idx
                    btn.Text = "  " .. opt
                    closeList()
                    if callback then callback(opt) end
                end)
            end
        else
            closeList()
        end
    end)

    UserInputService.InputBegan:Connect(function(i)
        if open and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
            task.wait()
            if open and listFrame then
                local mPos = UserInputService:GetMouseLocation()
                local ax, ay = listFrame.AbsolutePosition.X, listFrame.AbsolutePosition.Y
                local sx, sy = listFrame.AbsoluteSize.X, listFrame.AbsoluteSize.Y
                if mPos.X < ax or mPos.X > ax + sx or mPos.Y < ay or mPos.Y > ay + sy then
                    closeList()
                end
            end
        end
    end)
end

