local function play(id)
    for _, v in next, workspace:GetChildren() do
        if v.Name == "GUISound" then v:Destroy() end
    end
    local s = Instance.new("Sound", workspace)
    s.Name = "GUISound"
    s.Volume = 6
    s.SoundId = id
    s:Play()
end

