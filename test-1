        function InsideTab:CreateSlider(text, minvalue, maxvalue, callback)
            text = text or "Slider"
            minvalue = minvalue or 0
            maxvalue = maxvalue or 100
            callback = callback or function() end

            local mouse = game.Players.LocalPlayer:GetMouse()

            local Row = Instance.new("TextLabel")
            Row.Name = "Slider"
            Row.Parent = Frame
            Row.BackgroundTransparency = 1
            Row.Text = ""
            padRow(Row)

            local Label = Instance.new("TextLabel")
            Label.Parent = Row
            Label.BackgroundTransparency = 1
            Label.Position = UDim2.new(0, 0, 0, 0)
            Label.Size = UDim2.new(1, -170, 1, 0)
            Label.Font = Enum.Font.SourceSansSemibold
            Label.Text = text
            Label.TextColor3 = Color3.fromRGB(255,255,255)
            Label.TextSize = 14
            Label.TextXAlignment = Enum.TextXAlignment.Left

            local BarBack = Instance.new("ImageLabel")
            BarBack.Parent = Row
            BarBack.AnchorPoint = Vector2.new(1, 0.5)
            BarBack.Position = UDim2.new(1, -30, 0.5, 0)
            BarBack.Size = UDim2.new(0, 120, 0, 8)
            slice(BarBack, theme2, 0.02)

            local BarFill = Instance.new("ImageLabel")
            BarFill.Parent = BarBack
            BarFill.Size = UDim2.new(0, 0, 1, 0)
            slice(BarFill, theme3, 0.02)

            local ValLabel = Instance.new("TextLabel")
            ValLabel.Parent = Row
            ValLabel.BackgroundTransparency = 1
            ValLabel.AnchorPoint = Vector2.new(1, 0.5)
            ValLabel.Position = UDim2.new(1, 0, 0.5, 0)
            ValLabel.Size = UDim2.new(0, 28, 1, 0)
            ValLabel.Font = Enum.Font.SourceSansBold
            ValLabel.Text = tostring(minvalue)
            ValLabel.TextColor3 = theme3
            ValLabel.TextSize = 13

            local dragging = false
            local function update()
                local rel = math.clamp(mouse.X - BarBack.AbsolutePosition.X, 0, BarBack.AbsoluteSize.X)
                local alpha = rel / BarBack.AbsoluteSize.X
                local val = math.floor((maxvalue - minvalue) * alpha + minvalue)
                BarFill.Size = UDim2.new(alpha, 0, 1, 0)
                ValLabel.Text = tostring(val)
                pcall(callback, val)
            end

            BarBack.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    update()
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    update()
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)
        end

