local ROUND_IMG = "rbxassetid://3570695787"

-- slice(): only applies Image properties to ImageLabels. guards against misuse.
local function slice(img, color, scale)
    if not img:IsA("ImageLabel") then return end
    img.Image = ROUND_IMG
    img.ImageColor3 = color
    img.ScaleType = Enum.ScaleType.Slice
    img.SliceCenter = Rect.new(100,100,100,100)
    img.SliceScale = scale or 0.03
    img.BackgroundTransparency = 1
end

-- backing(): gives a TextButton a rounded slice look without touching its own props
local function backing(btn, color, scale, z)
    local back = Instance.new("ImageLabel")
    back.Name = "Backing"
    back.Parent = btn
    back.AnchorPoint = Vector2.new(0.5, 0.5)
    back.Position = UDim2.new(0.5, 0, 0.5, 0)
    back.Size = UDim2.new(1, 0, 1, 0)
    back.ZIndex = z or (btn.ZIndex - 1)
    slice(back, color, scale)
    return back
end

